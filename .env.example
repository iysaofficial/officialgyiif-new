# API publik dasbor IYSA. Situs ini hanya MEMBACA dari sini.
NEXT_PUBLIC_IYSA_API=https://api-dashboard.iysa.or.id/api/public/v1

# Seri event. Edisi mana yang disiarkan ditentukan pin di dasbor, bukan di
# sini — jadi saat GYIIF 2027 berganti ke 2028, berkas ini tidak berubah.
NEXT_PUBLIC_IYSA_SERIES=GYIIF

# Tujuan tombol daftar.
NEXT_PUBLIC_IYSA_DASHBOARD=https://dashboard.iysa.or.id
# UUID edisi yang dituju formulir pendaftaran. Ini SATU-SATUNYA nilai yang
# harus diganti tiap edisi baru — formulir dasbornya belum menerima slug.
NEXT_PUBLIC_IYSA_EVENT_ID=a03c7f2e-5581-4642-aeb6-8ff25c1e3e15

# Subdomain berjenama yang dialihkan ke formulir pendaftaran dasbor.
NEXT_PUBLIC_REGIST_HOST=regist.gyiif.or.id
